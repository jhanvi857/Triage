# ==============================================================================
# Triage Gateway — Environment Configuration
# ==============================================================================

# Server Port & Storage
PORT=8080
DB_PATH=ledger.db

# Spend Policy Limits (in INR)
DEFAULT_BUDGET_CAP_INR=10000
MANUAL_APPROVAL_THRESHOLD_INR=5000

# Razorpay API Credentials (Optional — defaults to sandbox mock emulator if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# Outbound Email Delivery (SMTP Relay)
# ==============================================================================
# For Gmail:
#   1. Set SMTP_HOST=smtp.gmail.com and SMTP_PORT=587
#   2. Set SMTP_USER=your-email@gmail.com
#   3. Generate an App Password in your Google Account (Security -> 2-Step Verification -> App Passwords)
#   4. Set SMTP_PASS=your-16-char-app-password
#
# For SendGrid / Mailgun / Amazon SES / Brevo:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=your-sendgrid-api-key
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CloudCompute Billing <billing@cloudcompute.io>
